rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Test doc
    match /_internal_/connection_test {
      allow get: if true; 
    }

    // ===============================================================
    // GLOBAL HELPERS
    // ===============================================================

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == "fio.davide@gmail.com" ||
        request.auth.token.email == "admin@cercartigiano.it" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // ===============================================================
    // DOMAIN RULES
    // ===============================================================

    // --- ADMINS ---
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- USERS ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin() || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['lastActiveAt', 'onboardingComplete', 'address', 'location', 'phone', 'nome', 'tokens', 'transactionHistory']));
      allow delete: if isAdmin();
    }

    // --- WORKER PROFILES ---
    match /workerProfiles/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- JOBS ---
    match /jobs/{jobId} {
      allow read: if true; // Permettiamo la lettura pubblica per la home
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --- PROPOSALS ---
    match /proposals/{proposalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --- CONVERSATIONS & MESSAGES ---
    match /conversations/{convId} {
      allow read, write: if isSignedIn();
    }

    // --- MESSAGES ---
    match /messages/{msgId} {
      allow read, write: if isSignedIn();
    }

    // --- BOOKINGS & WORK PROOFS ---
    match /bookings/{bookingId} {
      allow read, write: if isSignedIn();
    }

    match /workProofs/{proofId} {
      allow read, write: if isSignedIn();
    }

    // --- REVIEWS ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --- JOB Q&A ---
    match /jobQuestions/{questionId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || isSignedIn(); 
    }
    
    // --- VERIFICATIONS ---
    match /verifications/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // --- BILLING PROFILES ---
    match /billingProfiles/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // --- INVOICES ---
    match /invoices/{invoiceId} {
      allow read: if (isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()));
      allow create, update, delete: if isAdmin();
    }

    // --- ADMIN SETTINGS & CONFIG ---
    match /adminSettings/{docId} {
      allow read: if (docId == "config" && isSignedIn()) || isAdmin();
      allow write: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny for everything else unprotected
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
