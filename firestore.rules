rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email.lowerAscii() == "fio.davide@gmail.com") ||
        ('email' in request.auth.token && request.auth.token.email.lowerAscii() == "admin@cercartigiano.it") ||
        ('email' in request.auth.token && request.auth.token.email.lowerAscii() == "paparella@admin.it")
      );
    }

    // --- ADMINS ---
    match /admins/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- USERS ---
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (
        isAdmin() || 
        (request.auth.uid == userId && (
          !('tokens' in request.resource.data) || 
          !('tokens' in resource.data) || 
          request.resource.data.tokens <= resource.data.tokens
        ))
      );
      allow delete: if isAdmin();
    }

    // --- WORKER PROFILES ---
    match /workerProfiles/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // --- JOBS ---
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
    }

    // --- PROPOSALS ---
    match /proposals/{proposalId} {
      allow read: if true;
      allow create: if isSignedIn() && 
        request.resource.data.workerId == request.auth.uid && 
        get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.proposalCount < 5;
      allow update: if isSignedIn() && (resource.data.workerId == request.auth.uid || resource.data.clientId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.workerId == request.auth.uid || isAdmin());
    }

    // --- CONVERSATIONS ---
    match /conversations/{convId} {
      allow read, write: if isSignedIn();
    }

    // --- MESSAGES ---
    match /messages/{msgId} {
      allow read, write: if isSignedIn();
    }

    // --- REVIEWS ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- CONFIG & SETTINGS ---
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- INVOICES ---
    match /invoices/{invoiceId} {
      allow read, write: if isSignedIn();
    }

    // --- LOGS ---
    match /logs/{logId} {
      allow read, write: if true;
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notifId} {
      allow read, write: if isSignedIn();
    }

    // --- VERIFICATIONS ---
    match /verifications/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }
    
    // --- BILLING PROFILES ---
    match /billingProfiles/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // --- JOB QUESTIONS ---
    match /jobQuestions/{questionId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
