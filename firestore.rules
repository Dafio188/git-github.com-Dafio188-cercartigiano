rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email.lower() == "fio.davide@gmail.com") ||
        ('email' in request.auth.token && request.auth.token.email.lower() == "admin@cercartigiano.it")
      );
    }

    // --- ADMINS ---
    match /admins/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- USERS ---
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow write: if isAdmin();
    }

    // --- WORKER PROFILES ---
    match /workerProfiles/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;
      allow write: if isAdmin();
    }

    // --- JOBS ---
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // Permette ad altri utenti registrati (es. artigiani) di aggiornare proposalCount, hasNewProposals, unreadMessagesCount
      allow delete: if isSignedIn() && resource.data.clientId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // --- PROPOSALS ---
    match /proposals/{proposalId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // Permette sia all'artigiano che al cliente di modificare gli stati
      allow delete: if isSignedIn() && resource.data.workerId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // --- CONVERSATIONS ---
    match /conversations/{convId} {
      allow read, write: if isSignedIn();
    }

    // --- MESSAGES ---
    match /messages/{msgId} {
      allow read, write: if isSignedIn();
    }

    // --- REVIEWS ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- CONFIG & SETTINGS ---
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- INVOICES ---
    match /invoices/{invoiceId} {
      allow read, write: if isSignedIn();
    }

    // --- LOGS ---
    match /logs/{logId} {
      allow read, write: if true;
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notifId} {
      allow read, write: if isSignedIn();
    }

    // --- VERIFICATIONS ---
    match /verifications/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;
      allow write: if isAdmin();
    }
    
    // --- BILLING PROFILES ---
    match /billingProfiles/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;
      allow write: if isAdmin();
    }

    // --- JOB QUESTIONS ---
    match /jobQuestions/{questionId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
