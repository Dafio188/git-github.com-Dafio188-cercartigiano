rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Test doc
    match /_internal_/connection_test {
      allow get: if true; 
    }

    // ===============================================================
    // GLOBAL HELPERS
    // ===============================================================

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == "fio.davide@gmail.com" ||
        request.auth.token.email == "admin@cercartigiano.it"
      ); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // ===============================================================
    // DOMAIN RULES
    // ===============================================================

    // --- USERS ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin() || isSignedIn(); // Permissivo per test
      allow delete: if isAdmin();
    }

    // --- WORKER PROFILES ---
    match /workerProfiles/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- JOBS ---
    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().clientId == request.auth.uid;
      allow update: if isSignedIn(); // Permissivo per test
      allow delete: if isAdmin();
    }

    // --- PROPOSALS ---
    match /proposals/{proposalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --- CONVERSATIONS & MESSAGES ---
    match /conversations/{convId} {
      allow read, write: if isSignedIn();
    }

    // --- MESSAGES ---
    match /messages/{msgId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participantIds || 'SHARED' in resource.data.participantIds);
      allow create: if isSignedIn() && 
        (request.auth.uid in request.resource.data.participantIds || 'SHARED' in request.resource.data.participantIds) && 
        request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participantIds || 'SHARED' in resource.data.participantIds);
      allow delete: if isAdmin();
    }

    // --- BOOKINGS & WORK PROOFS ---
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (request.auth.uid == existing().clientId || request.auth.uid == existing().workerId || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /workProofs/{proofId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --- REVIEWS ---
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --- JOB Q&A ---
    match /jobQuestions/{questionId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == existing().userId || isAdmin());
      allow delete: if isAdmin();
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notifId} {
      allow read: if isSignedIn(); // Users need to read notifications addressed to them or 'all'
      allow create: if isSignedIn() || isAdmin();
      allow update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }
    
    // --- VERIFICATIONS ---
    match /verifications/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- BILLING PROFILES ---
    match /billingProfiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- INVOICES ---
    match /invoices/{invoiceId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAdmin(); // Server usually creates invoices, but adding if needed
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- ADMIN SETTINGS & CONFIG ---
    match /adminSettings/{docId} {
      allow read: if (docId == "config" && isSignedIn()) || isAdmin();
      allow write: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true; // Everyone can read config (e.g. maintenance mode check)
      allow write: if isAdmin();
    }

    // Default deny for everything else unprotected
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
