rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny Catch-all for non-signed-in users
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // GLOBAL HELPERS
    // ===============================================================

    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.get('email', '').lower() == "fio.davide@gmail.com" ||
        request.auth.token.get('email', '').lower() == "admin@cercartigiano.it" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }

    // ===============================================================
    // DOMAIN RULES
    // ===============================================================

    // --- ADMINS ---
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- USERS ---
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    // --- WORKER PROFILES ---
    match /workerProfiles/{userId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- JOBS ---
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- PROPOSALS ---
    match /proposals/{proposalId} {
      allow read, write: if isSignedIn();
    }

    // --- CONVERSATIONS ---
    match /conversations/{convId} {
      allow read, write: if isSignedIn();
    }

    // --- MESSAGES ---
    match /messages/{msgId} {
      allow read, write: if isSignedIn();
    }

    // --- REVIEWS ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- CONFIG & SETTINGS ---
    match /config/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Sensitive admin-only settings
    match /adminSettings/{docId} {
      allow read, write: if isSignedIn();
    }

    // Invoices
    match /invoices/{invoiceId} {
      allow read, write: if isSignedIn();
    }

    // Logs
    match /logs/{logId} {
      allow read, write: if isSignedIn();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read, write: if isSignedIn();
    }

    // Verification and billing profiles
    match /verifications/{userId} {
      allow read, write: if isSignedIn();
    }
    
    match /billingProfiles/{userId} {
      allow read, write: if isSignedIn();
    }

    // Pre-bid questions (Job Questions)
    match /jobQuestions/{questionId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
