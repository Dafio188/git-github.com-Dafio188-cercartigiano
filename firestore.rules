rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // GLOBAL HELPERS
    // ===============================================================

    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == "fio.davide@gmail.com" ||
        request.auth.token.email == "admin@cercartigiano.it" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // ===============================================================
    // DOMAIN RULES
    // ===============================================================

    // --- ADMINS ---
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- USERS ---
    match /users/{userId} {
      // Gli admin possono leggere tutti, gli utenti possono leggere se stessi o se sono in una conversazione (semplificato qui per ora)
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin() || (exists(/databases/$(database)/documents/workerProfiles/$(userId))));
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin() || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['lastActiveAt', 'onboardingComplete', 'address', 'location', 'phone', 'nome', 'tokens', 'transactionHistory']));
      allow delete: if isAdmin();
    }

    // --- WORKER PROFILES ---
    match /workerProfiles/{userId} {
      allow read: if true; // Profili pubblici
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- JOBS ---
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isVerified();
      allow update: if isAdmin() || (isSignedIn() && (existing().clientId == request.auth.uid || existing().assignedWorkerId == request.auth.uid));
      allow delete: if isAdmin();
    }

    // --- PROPOSALS ---
    match /proposals/{proposalId} {
      allow read: if isSignedIn() && (resource.data.workerId == request.auth.uid || resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isVerified();
      allow update: if isSignedIn() && (existing().workerId == request.auth.uid || existing().clientId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // --- CONVERSATIONS ---
    match /conversations/{convId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid in existing().participants || isAdmin());
      allow delete: if isAdmin();
    }

    // --- MESSAGES ---
    match /messages/{msgId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --- REVIEWS ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isVerified();
      allow update: if isAdmin() || (isSignedIn() && existing().clientId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // --- CONFIG & SETTINGS ---
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminSettings/{docId} {
      allow read: if isAdmin() || (isSignedIn() && docId == 'config');
      allow write: if isAdmin();
    }

    // Invoices are sensitive
    match /invoices/{invoiceId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Other collections
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all' || isAdmin());
      allow write: if isAdmin();
    }

    match /verifications/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    match /billingProfiles/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
  }
}
